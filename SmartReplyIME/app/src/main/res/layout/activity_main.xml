<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="智能回复输入法"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:text="1. 启用输入法并打开开关
2. 切换输入法选择本输入法
3. （可选）开启消息读取后，键盘上的“AI回复”会根据对方最新消息生成回复建议

数据全部本地处理，不上传任何内容。" />

    <Button
        android:id="@+id/btnEnableIme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="1. 启用输入法" />

    <Button
        android:id="@+id/btnPickIme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. 切换输入法" />

    <Button
        android:id="@+id/btnEnableA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="3. 开启消息读取（可选）" />

    <Button
        android:id="@+id/btnTemplates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4. 自定义回复模板" />

</LinearLayout>
